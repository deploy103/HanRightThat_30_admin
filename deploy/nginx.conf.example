# admin.hanwol.site -> HanRightThat_30_admin 컨테이너 리버스 프록시 예시.
#
# 이 설정은 리버스 프록시 서버(웹 VM과 별도 서버)에서 실행한다고 가정한다.
# proxy_pass 의 WEB_VM_PRIVATE_IP 를 실제 웹 VM의 프라이빗 IP로 바꿀 것
# (같은 VM에서 리버스 프록시까지 함께 돌린다면 127.0.0.1 로 바꿔도 된다).
# 웹 VM 쪽 docker-compose 의 BIND_ADDR 도 이 프록시 서버가 접근 가능한 주소로 맞춰야 한다.
# 실제 서버 경로/인증서 경로는 환경에 맞게 조정한다.

server {
    listen 80;
    server_name admin.hanwol.site;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name admin.hanwol.site;

    ssl_certificate     /etc/letsencrypt/live/admin.hanwol.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.hanwol.site/privkey.pem;

    # 검색엔진 노출 방지 (index.html 의 robots 메타와 별개로 한 번 더 막는다)
    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        proxy_pass http://WEB_VM_PRIVATE_IP:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
